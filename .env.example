# vidra-user — example environment. Copy to .env.local and adjust for local dev.
# Never commit a real .env or any secrets/tokens.

# Base URL of the vidra-core API the frontend calls. NEXT_PUBLIC_ is exposed to
# the browser, so this must be a non-secret URL only.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Logging level: debug | info | warn | error (default info). Never debug in prod.
LOG_LEVEL=info

# OpenTelemetry: opt-in, zero cost when off (see .ralph/specs/observability.md).
# When OTEL_ENABLED=true, instrumentation.ts registers the OTel SDK and every
# server-side call to vidra-core carries a W3C traceparent that lines up with
# vidra-core's traces. The exporter target/protocol below follow the standard
# OTLP env vars (read by @vercel/otel); all are server-side only (no NEXT_PUBLIC_).
OTEL_ENABLED=false
OTEL_SERVICE_NAME=vidra-user
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
