{
  "name": "vidra-user",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/copy-olm-wasm.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:icons": "node scripts/check-no-emoji.mjs",
    "typecheck": "tsc --noEmit",
    "codegen": "node scripts/codegen.mjs",
    "design:shots": "node scripts/design-shots.mjs",
    "test": "vitest run",
    "e2e": "playwright test --project=chromium",
    "e2e:backed": "playwright test --project=backend-backed",
    "ci": "npm run typecheck && npm run lint && npm run lint:icons && npm run test && npm run build && npm run e2e"
  },
  "dependencies": {
    "@matrix-org/olm": "^3.2.15",
    "@opentelemetry/api": "^1.9.1",
    "@vercel/otel": "^1.14.2",
    "hls.js": "^1.6.16",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@opentelemetry/core": "^1.30.1",
    "@playwright/test": "^1.49.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jsdom": "^29.1.1",
    "jsqr": "^1.4.0",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.0.0"
  }
