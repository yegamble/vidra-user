{
  "name": "vidra-user",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/copy-olm-wasm.mjs",
    "build": "next build",
    "preanalyze": "node scripts/copy-olm-wasm.mjs",
    "analyze": "next experimental-analyze --output",
    "start": "next start",
    "lint": "eslint",
    "lint:icons": "node scripts/check-no-emoji.mjs",
    "typecheck": "tsc --noEmit",
    "codegen": "node scripts/codegen.mjs",
    "generate:icons": "node scripts/generate-icons.mjs",
    "design:shots": "node scripts/design-shots.mjs",
    "test": "vitest run",
    "e2e": "playwright test --project=chromium",
    "e2e:backed": "playwright test --project=backend-backed",
    "ci": "npm run typecheck && npm run lint && npm run lint:icons && npm run test && NEXT_PUBLIC_API_BASE_URL=http://localhost:8080 npm run build && npm run e2e"
  },
  "dependencies": {
    "@matrix-org/olm": "^3.2.15",
    "@opentelemetry/api": "^1.9.1",
    "@vercel/otel": "^2.1.3",
    "hls.js": "^1.7.1",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@opentelemetry/core": "^2.9.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "16.3.3",
    "jsdom": "^30.0.1",
    "jsqr": "^1.4.0",
    "openapi-typescript": "^7.13.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
